@@ -247,6 +247,58 @@ private:
 		Framework::OpenGl::CRenderbuffer m_colorBufferMs;
 
 		CGsCachedArea m_cachedArea;
+
+		//The XYOFFSET.OFY (in pixels) the primitives drawn into this buffer since it was
+		//last shown used, as a small histogram, and the one most of them used the last time
+		//it was shown. A game that renders in field mode draws its odd field with the
+		//offset moved half a line (the PS2 SDK's sceGsSetHalfOffset), so that field's
+		//content sits half a line up in its buffer; FlipImpl uses the difference between
+		//the two fields' offsets to show them in the same place (see FieldPresentOffset).
+		//The most-used offset rather than the last one: a game may finish each field with
+		//an overlay drawn at a fixed offset, which says nothing about where the scene is.
+		struct DRAW_OFFSET_COUNT
+		{
+			float ofsY = 0;
+			uint32 count = 0;
+		};
+		static constexpr unsigned int DRAW_OFFSET_SLOTS = 4;
+		DRAW_OFFSET_COUNT m_drawOfsYHist[DRAW_OFFSET_SLOTS];
+		float m_drawOfsY = 0;
+		void CountDrawOfsY(float ofsY)
+		{
+			for(auto& slot : m_drawOfsYHist)
+			{
+				if((slot.count != 0) && (slot.ofsY == ofsY))
+				{
+					slot.count++;
+					return;
+				}
+			}
+			for(auto& slot : m_drawOfsYHist)
+			{
+				if(slot.count == 0)
+				{
+					slot.ofsY = ofsY;
+					slot.count = 1;
+					return;
+				}
+			}
+			//More than four offsets in one field: the first slot stands for the rest.
+			m_drawOfsYHist[0].count++;
+		}
+		void SettleDrawOfsY()
+		{
+			uint32 best = 0;
+			for(auto& slot : m_drawOfsYHist)
+			{
+				if(slot.count > best)
+				{
+					best = slot.count;
+					m_drawOfsY = slot.ofsY;
+				}
+				slot.count = 0;
+			}
+		}
 	};
