+float CGSH_OpenGL::FieldPresentOffset(const FramebufferPtr& framebuffer)
+{
+	//Field mode: SMODE2 interlaced with FFMD set, each field a half-height buffer
+	//(GetDisplayRect halves the height for the same condition). The two fields were drawn
+	//with XYOFFSETs half a line apart; the one drawn higher is shown that much lower.
+	//Compared with the field shown at the previous flip rather than with a fixed parity:
+	//whichever of the two has the larger offset is the one moved up, whatever the game
+	//calls it. A whole-line difference is a different origin (a menu buffer, say), not a
+	//field offset, and is left alone.
+	framebuffer->SettleDrawOfsY();
+	if(!(GetCrtIsInterlaced() && GetCrtIsFrameMode()))
+	{
+		m_lastPresentedOfsYValid = false;
+		return 0;
+	}
+	float ofsY = framebuffer->m_drawOfsY;
+	float result = 0;
+	if(m_lastPresentedOfsYValid)
+	{
+		float delta = ofsY - m_lastPresentedOfsY;
+		if(delta == 0.f)
+		{
+			//The same field again (a repeated frame): keep it where it was.
+			result = m_lastPresentedShift;
+		}
+		else if((delta > 0.f) && (delta < 1.f))
+		{
+			result = delta;
+		}
+	}
+	m_lastPresentedOfsY = ofsY;
+	m_lastPresentedShift = result;
+	m_lastPresentedOfsYValid = true;
+	return result;
+}
