+	//GL texture names come from a pool and go back to one. In the browser build glGenTextures
+	//and glDeleteTextures are synchronous calls proxied to the main thread (the GS thread stops
+	//until the main thread has run everything queued before them), and the texture and palette
+	//caches create and destroy a texture on every miss. Names are generated 64 at a time, and
+	//released names are deleted together once per frame (or sooner if many pile up).
+	GLuint AllocTextureName();
+	static void ReleaseTextureName(GLuint);
+	void FlushTextureNameDeletes();
+	void ClearTextureNamePool();
+
+	//A texture name from the pool; the texture cache's handle type.
+	class CTextureName
+	{
+	public:
+		CTextureName() = default;
+		explicit CTextureName(GLuint handle)
+		    : m_handle(handle)
+		{
+		}
+		CTextureName(const CTextureName&) = delete;
+		CTextureName(CTextureName&& rhs)
+		{
+			std::swap(m_handle, rhs.m_handle);
+		}
+		~CTextureName()
+		{
+			Reset();
+		}
+		CTextureName& operator=(const CTextureName&) = delete;
+		CTextureName& operator=(CTextureName&& rhs)
+		{
+			Reset();
+			std::swap(m_handle, rhs.m_handle);
+			return (*this);
+		}
+		operator GLuint() const
+		{
+			return m_handle;
+		}
+		void Reset()
+		{
+			if(m_handle != 0)
+			{
+				ReleaseTextureName(m_handle);
+				m_handle = 0;
+			}
+		}
+
+	private:
+		GLuint m_handle = 0;
+	};
