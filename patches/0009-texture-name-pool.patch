+/////////////////////////////////////////////////////////////
+// Texture names
+/////////////////////////////////////////////////////////////
+
+static std::vector<GLuint> g_freeTextureNames;
+static std::vector<GLuint> g_pendingTextureDeletes;
+
+GLuint CGSH_OpenGL::AllocTextureName()
+{
+	if(g_freeTextureNames.empty())
+	{
+		static const unsigned int REFILL_COUNT = 64;
+		g_freeTextureNames.resize(REFILL_COUNT);
+		glGenTextures(REFILL_COUNT, g_freeTextureNames.data());
+		CHECKGLERROR();
+	}
+	GLuint name = g_freeTextureNames.back();
+	g_freeTextureNames.pop_back();
+	return name;
+}
+
+void CGSH_OpenGL::ReleaseTextureName(GLuint name)
+{
+	assert(name != 0);
+	g_pendingTextureDeletes.push_back(name);
+}
+
+void CGSH_OpenGL::FlushTextureNameDeletes()
+{
+	if(g_pendingTextureDeletes.empty()) return;
+	glDeleteTextures(static_cast<GLsizei>(g_pendingTextureDeletes.size()), g_pendingTextureDeletes.data());
+	CHECKGLERROR();
+	g_pendingTextureDeletes.clear();
+}
+
+void CGSH_OpenGL::ClearTextureNamePool()
+{
+	FlushTextureNameDeletes();
+	if(!g_freeTextureNames.empty())
+	{
+		glDeleteTextures(static_cast<GLsizei>(g_freeTextureNames.size()), g_freeTextureNames.data());
+		CHECKGLERROR();
+		g_freeTextureNames.clear();
+	}
+}
