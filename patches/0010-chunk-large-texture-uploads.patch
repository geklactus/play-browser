+//glTexSubImage2D on the bound GL_TEXTURE_2D. In the browser build Emscripten copies an
+//image smaller than 256KB and queues the upload, but runs a larger one synchronously: the GS
+//thread stops until the main thread has drained everything queued before it. A 256x256
+//32-bit texture is exactly 256KB, a 512x512 8-bit one too, and a movie frame several times
+//that. Uploads that size are split into bands of rows that each stay under the limit.
+void CGSH_OpenGL::TexSubImage2D(unsigned int texX, unsigned int texY, unsigned int texWidth, unsigned int texHeight, GLenum format, GLenum type, unsigned int bytesPerPixel, const void* pixels)
+{
+#ifdef __EMSCRIPTEN__
+	static const unsigned int MAX_ASYNC_UPLOAD_SIZE = 256 * 1024;
+	unsigned int rowSize = texWidth * bytesPerPixel;
+	if(((rowSize * texHeight) >= MAX_ASYNC_UPLOAD_SIZE) && (rowSize < MAX_ASYNC_UPLOAD_SIZE))
+	{
+		unsigned int rowsPerBand = (MAX_ASYNC_UPLOAD_SIZE - 1) / rowSize;
+		for(unsigned int y = 0; y < texHeight; y += rowsPerBand)
+		{
+			unsigned int rows = std::min(rowsPerBand, texHeight - y);
+			glTexSubImage2D(GL_TEXTURE_2D, 0, texX, texY + y, texWidth, rows, format, type,
+			                reinterpret_cast<const uint8*>(pixels) + (static_cast<size_t>(y) * rowSize));
+		}
+		return;
+	}
+#endif
+	glTexSubImage2D(GL_TEXTURE_2D, 0, texX, texY, texWidth, texHeight, format, type, pixels);
+}
