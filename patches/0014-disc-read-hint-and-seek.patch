+//Reads used to copy their sectors into memory when they were issued and only then start the
+//modelled drive time (COMMAND_READ_BASE_DELAY + a sector delay per sector), so a disc that
+//takes a while to answer (the browser build reads it over the network) stopped the whole VM for
+//as long as it took, and the drive time came on top. Now a read tells the disc's stream which
+//sectors are coming the moment it's issued (HintRead: the page starts fetching them), and the
+//sectors are copied when the drive time is up: if they arrived meanwhile, nothing waits; if
+//not, only for what's left. The drive time also gets a seek (MoveHead) when a read doesn't carry
+//on from the previous one, as a real drive's would - and that is when a remote disc's bytes are
+//least likely to be at hand.
+uint32 CCdvdman::MoveHead(uint32 sector, uint32 count)
+{
+	uint32 from = m_headSector;
+	m_headSector = sector + count;
+	if((m_seekFullStrokeMs == 0) || (sector == from))
+	{
+		return 0;
+	}
+	uint64 nearUs = static_cast<uint64>(m_seekFullStrokeMs) * 1000 / 5;
+	uint64 farUs = static_cast<uint64>(m_seekFullStrokeMs) * 1000;
+	if((sector > from) && ((sector - from) <= SEEK_READTHROUGH_SECTORS))
+	{
+		//A few sectors ahead: the drive reads through them rather than seeking
+		uint64 throughCycles = static_cast<uint64>(sector - from) * COMMAND_READ_SECTOR_DELAY;
+		return static_cast<uint32>(std::min<uint64>(throughCycles, TimeUtils::UsecsToCycles(PS2::IOP_CLOCK_OVER_FREQ, nearUs)));
+	}
+	uint64 distance = (sector > from) ? (sector - from) : (from - sector);
+	distance = std::min<uint64>(distance, SEEK_DVD_LAYER_SECTORS);
+	uint64 seekUs = nearUs + ((farUs - nearUs) * distance / SEEK_DVD_LAYER_SECTORS);
+	return static_cast<uint32>(TimeUtils::UsecsToCycles(PS2::IOP_CLOCK_OVER_FREQ, seekUs));
+}
+
+uint32 CCdvdman::SeekForRead(uint32 sector, uint32 count)
