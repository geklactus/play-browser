+//The drive has been asked for [position, position + size) and will read it when its modelled
+//time is up (CCdvdman). Tell the page now, without waiting for it, so that it starts fetching
+//those bytes; by the time the read comes, they may be there. A page without hint() (an older
+//ps2.js) just doesn't hear about it.
+void CJsDiscImageDeviceStream::HintRead(uint64 position, uint64 size, uint32 source, uint32 seekUs)
+{
+	if(size == 0) return;
+	m_hintStart = position;
+	m_hintEnd = position + size;
+	MAIN_THREAD_ASYNC_EM_ASM({
+		const device = Module.discImageDevice;
+		if(device && device.hint)
+		{
+			device.hint(($0 >>> 0) + (($1 >>> 0) * 4294967296), $2 >>> 0, $3, $4 >>> 0);
+		}
+	},
+	                         static_cast<uint32>(position), static_cast<uint32>(position >> 32),
+	                         static_cast<uint32>(std::min<uint64>(size, 0xFFFFFFFFULL)), source, seekUs);
+}
+
+void CJsDiscImageDeviceStream::SharePresence()
+{
+	if(m_presenceAsked) return;
+	m_presenceAsked = true;
+	m_pageHasPresence = MAIN_THREAD_EM_ASM_INT({
+		const device = Module.discImageDevice;
+		return (device && (typeof device.presence === "function")) ? 1 : 0;
+	}) != 0;
+	if(!m_pageHasPresence) return;
+	uint64 count = (GetFileSize() + (1ULL << PRESENCE_SHIFT) - 1) >> PRESENCE_SHIFT;
+	m_presence.assign(std::max<uint64>(count, 1), 0);
+	MAIN_THREAD_ASYNC_EM_ASM({
+		const device = Module.discImageDevice;
+		if(device && device.presence)
+		{
+			device.presence($0, $1 >>> 0, $2);
+		}
+	},
+	                         m_presence.data(), static_cast<uint32>(m_presence.size()), static_cast<int>(PRESENCE_SHIFT));
+}
+
+//Does the page have every MiB of [position, position + size) at hand? A page that keeps the map:
+//not until it says so (so not in the first moments either). A page without presence(): yes.
+bool CJsDiscImageDeviceStream::IsAtHand(uint64 position, uint64 size)
+{
+	SharePresence();
+	if(!m_pageHasPresence) return true;
+	if(size == 0) return true;
+	uint64 first = position >> PRESENCE_SHIFT;
+	uint64 last = (position + size - 1) >> PRESENCE_SHIFT;
+	for(uint64 i = first; i <= last; i++)
+	{
+		if(i >= m_presence.size()) return false;
+		if(__atomic_load_n(&m_presence[i], __ATOMIC_RELAXED) == 0) return false;
+	}
+	return true;
+}
